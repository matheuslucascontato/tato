NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Origem confiável para links de e-mail; sem barra final. Altere ao usar preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Só para teste isolado contra Supabase local, nunca contra contas reais:
# TATO_TEST_SUPABASE_URL=http://127.0.0.1:54321
# TATO_TEST_SUPABASE_KEY=CHAVE_PUBLICAVEL_LOCAL
# TATO_TEST_EMAIL_A=usuario-a-de-teste@seu-dominio.test
# TATO_TEST_PASSWORD_A=SENHA_APENAS_DE_TESTE
# TATO_TEST_EMAIL_B=usuario-b-de-teste@seu-dominio.test
# TATO_TEST_PASSWORD_B=SENHA_APENAS_DE_TESTE

# Opcional: JWT de sessão de usuário EXISTENTE para check:supabase. Nunca cole no chat/Git.
# TATO_TEST_ACCESS_TOKEN=TOKEN_DE_TESTE_EXISTENTE

# IA: exclusivamente no servidor; configure o Secret apenas no Preview da Vercel.
# Não copie o Secret da Vercel para o ambiente local. Testes automáticos usam mocks.
OPENAI_API_KEY=SUBSTITUA_APENAS_NO_SERVIDOR
OPENAI_MODEL=gpt-5.4-mini
# false bloqueia novas chamadas pagas sem parar o controle manual/confirmações.
TATO_AI_ENABLED=true
